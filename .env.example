# ==============================================================================
# Cairo University - Faculty of Engineering (CUFE)
# Student Financial Portal (Pre-Production Pilot)
# Environment Variables Template
# ==============================================================================

# Supabase Managed Backend (Free Tier / Zero-Cost Pilot)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Server-Side Only Service Key (NEVER expose to browser/client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Cryptographic Receipt Signature Secret (Server-Side Only - NEVER passed to Postgres RPC)
RECEIPT_HMAC_SECRET="generate-a-secure-random-64-character-hex-string-for-hmac-verification"

# Application URL for QR Code Verification links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Default Internationalization Locale
NEXT_PUBLIC_DEFAULT_LOCALE="ar"
